# ── Infrastructure (docker-compose) ──
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
MINIO_ROOT_PASSWORD=changeme

# ── Shared (API + Worker) ──
DATABASE_URL=postgresql://factory:changeme@localhost:5432/factory
REDIS_URL=redis://default:changeme@localhost:6379

# ── API ──
WEBHOOK_SECRET=whsec_changeme
# PORT=3000
# HOST=0.0.0.0
# CORS_ORIGINS=http://localhost:5173

# ── Worker: Temporal ──
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default

# ── Worker: GitHub App (required — pipeline cannot function without these) ──
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# ── Worker: LLM (required for plan + implement phases) ──
OPENROUTER_API_KEY=

# ── Worker: MinIO / S3 (required for evidence storage) ──
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ROOT_USER=factory
# MINIO_BUCKET=factory-artifacts

# ── Worker: Docker ──
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# ── Worker: API URL (for callbacks) ──
# API_URL=http://localhost:3000
